# Copy to .env.live and fill in. .env.live is gitignored — never commit real keys.
# This file is loaded ONLY when mode: live in config.yaml.
# These are DIFFERENT keys from testnet. Restrict to spot trading only;
# do NOT enable withdrawals.

# ---- Binance LIVE (REAL MONEY) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Telegram alerts (must also be in .env for paper mode) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
