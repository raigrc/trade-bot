# Copy to .env and fill in. .env is gitignored — never commit real keys.
# This file holds TESTNET keys + telegram creds for paper/backtest modes.

# ---- Binance TESTNET (paper trading) ----
# Generate at https://testnet.binance.vision (log in with GitHub).
# Testnet balances are virtual; resets ~monthly (keys are preserved).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ---- Telegram alerts (optional but recommended) ----
# Create a bot via @BotFather; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: Live keys live in .env.live (separate file, same gitignore rules).
